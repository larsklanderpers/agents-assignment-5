# LLM Provider: "openai" or "google" (set "google" to use GOOGLE_API_KEY with Gemini)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google (alternative)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-3.8-flash

# LangSmith (server tracing and upload_to_langsmith). Use a real key or delete the
# LANGSMITH_API_KEY line: with this placeholder the server logs 403 errors.
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=financial-approval-system

# RAGAS: turn off its anonymous usage analytics (it sends them by default)
RAGAS_DO_NOT_TRACK=true

# Budget
BUDGET_CEILING=100000

# Checkpointer
CHECKPOINT_DB=checkpoints.db
